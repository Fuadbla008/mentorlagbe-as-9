# ---------------------------------------------------------------------------
# Frontend environment (Next.js). Copy this file to .env.local.
# NEVER put backend secrets here: MONGO_URI, JWT_SECRET, IMGBB_KEY,
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET belong in the Express server .env.
# ---------------------------------------------------------------------------

# Deployed Express API base URL (must include the /api suffix).
NEXT_PUBLIC_API_URL=https://mentorlagbe-as-9-server.onrender.com/api

# Image uploads go through the backend proxy, so no ImgBB key is exposed here.
NEXT_PUBLIC_UPLOAD_URL=https://mentorlagbe-as-9-server.onrender.com/api/upload/image

# Optional dev-only fallback. Keep this EMPTY in production.
NEXT_PUBLIC_IMGBB_KEY=

# Google Identity Services client ID. Optional — enables "Continue with Google".
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# add your deployed origin to "Authorised JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=980122925589-abv036nq1roc2hmn62gr31t82q3u4f89.apps.googleusercontent.com
